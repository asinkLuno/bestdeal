<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 游戏原生 mod 要求 netstandard2.1，直接引用游戏自带的程序集（不要打包进 DLL） -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BestDeal</AssemblyName>
    <RootNamespace>BestDeal</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- 覆盖方式：dotnet build -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">/run/media/deck/SR256/steamapps/common/Probably Stolen</GameDir>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 用游戏自带的 Harmony，自带副本会被模组扫描器直接拒绝 -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)/Probably Stolen_Data/Managed/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' != 'false'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/Mods/BestDeal/" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)manifest.xml" DestinationFolder="$(GameDir)/Mods/BestDeal/" />
    <Message Importance="high" Text="已部署到 $(GameDir)/Mods/BestDeal/" />
  </Target>

</Project>
